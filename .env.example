# Obrigatórias para o backend
NODE_ENV=development
PORT=10000
DATABASE_URL=<DATABASE_URL_EXCLUSIVA_STAGING>
JWT_SECRET=<JWT_SECRET_EXCLUSIVO_STAGING_COM_PELO_MENOS_32_CARACTERES>

# Integração de currículo / Triagem (nunca versionar valores reais)
GROQ_API_KEY=<GROQ_API_KEY>
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=30000

# Triagem Inteligente: desligada por padrão
TRIAGEM_IA_ENABLED=false
TRIAGEM_IA_PREVIEW_ONLY=true
TRIAGEM_IA_AUTO=false
TRIAGEM_IA_BATCH=false
TRIAGEM_IA_ALLOWED_ENVIRONMENTS=staging,preview
TRIAGEM_IA_MAX_TOKENS=5000
TRIAGEM_IA_MAX_POR_MINUTO=5
TRIAGEM_IA_MAX_POR_DIA_EMPRESA=100

# Frontends / URLs
FRONTEND_URL=https://example.invalid
API_PUBLIC_URL=https://example.invalid
ADMIN_FRONTEND_URL=https://example.invalid
EMPRESA_FRONTEND_URL=https://example.invalid
CANDIDATE_FRONTEND_URL=https://example.invalid
SISTEMA_NOME=VagasIO
SISTEMA_URL=https://example.invalid
CONTACT_EMAIL=contato@example.invalid
CONTATO_EMAIL=contato@example.invalid
EMAIL_FROM=contato@example.invalid
EMAIL_FROM_VAGASIO=contato@example.invalid
EMAIL_REMETENTE_AMIGAVEL=VagasIO

# E-mail / notificações
EMAIL_APP_PASSWORD=<EMAIL_APP_PASSWORD>
RESEND_API_KEY=<RESEND_API_KEY>
RESENDAPIKEY=<RESEND_API_KEY>
RESEND_KEY=<RESEND_API_KEY>
WEB3FORMS_ACCESS_KEY=<WEB3FORMS_ACCESS_KEY>
WEB3FORMS_API_KEY=<WEB3FORMS_API_KEY>
WEB3FORMS_KEY=<WEB3FORMS_KEY>
CHAT_EMAIL_DEDUP_MIN=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>
CLOUDINARY_URL=<CLOUDINARY_URL>

# Google / OAuth / Meet
GOOGLE_OAUTH_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<GOOGLE_OAUTH_CLIENT_SECRET>
GCP_SERVICE_ACCOUNT_JSON=<GCP_SERVICE_ACCOUNT_JSON>
MEET_ADMIN_EMAIL=<MEET_ADMIN_EMAIL>
WEBAUTHN_ORIGIN=https://example.invalid
WEBAUTHN_RP_ID=example.invalid

# Asaas
ASAAS_API_BASE=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=<ASAAS_API_KEY>
ASAAS_WEBHOOK_TOKEN=<ASAAS_WEBHOOK_TOKEN>

# Videochamada
VAGASIO_VIDEO_CALLS=false
VAGASIO_VIDEO_SIGNAL_URL=https://example.invalid
VAGASIO_VIDEO_JWT_SECRET=<VAGASIO_VIDEO_JWT_SECRET>
VAGASIO_VIDEO_PREVIEW_JWT_SECRET=<VAGASIO_VIDEO_PREVIEW_JWT_SECRET>
VAGASIO_VIDEO_ROOM_TTL_SECONDS=7200

# Push / segurança / Face
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>
VAPID_SUBJECT=mailto:contato@example.invalid
IP_HASH_SALT=<IP_HASH_SALT>
FACE_TEMPLATE_SECRET=<FACE_TEMPLATE_SECRET>
FACE_DEBUG_LOGS=false

# Apple Sign In
APPLE_CLIENT_ID=<APPLE_CLIENT_ID>
APPLE_KEY_ID=<APPLE_KEY_ID>
APPLE_TEAM_ID=<APPLE_TEAM_ID>
APPLE_PRIVATE_KEY=<APPLE_PRIVATE_KEY>

# Administração / CI / jobs
ADMIN_EMAIL=admin@example.invalid
ADMIN_NOTIF_EMAIL=admin@example.invalid
ADMIN_SENHA=<ADMIN_SENHA>
MASTER_ADMIN_ID=<MASTER_ADMIN_ID>
CI_ADMIN_SECRET=<CI_ADMIN_SECRET>
CRON_SECRET=<CRON_SECRET>

# Debug: em produção mantenha desligado e sem DEBUG_API_KEY
DEBUG_API=0
DEBUG_API_KEY=<DEBUG_API_KEY>
