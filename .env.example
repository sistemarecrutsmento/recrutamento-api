# =============================================================
# .env.example — VagasIO Backend
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# Gerado/atualizado na Fase 15 (28/07/2026).
# =============================================================

# ── Ambiente ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Banco de Dados ────────────────────────────────────────────
DATABASE_URL=postgres://usuario:senha@localhost:5432/recrutamento

# ── JWT ───────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Admin inicial ─────────────────────────────────────────────
ADMIN_EMAIL=admin@vagasio.com.br
ADMIN_SENHA=
ADMIN_NOTIF_EMAIL=

# ── E-mail (Resend — recomendado) ─────────────────────────────
RESEND_API_KEY=re_...
EMAIL_REMETENTE_AMIGAVEL=VagasIO

# ── E-mail (SMTP alternativo — Gmail App Password) ───────────
EMAIL_FROM=
EMAIL_APP_PASSWORD=
EMAIL_FROM_VAGASIO=

# ── Sistema ────────────────────────────────────────────────────
SISTEMA_NOME=VagasIO
SISTEMA_URL=https://sistemarecrutsmento.github.io/vagas
FRONTEND_URL=https://sistemarecrutsmento.github.io/vagas
CORS_ORIGIN=https://sistemarecrutsmento.github.io

# ── Cloudinary (upload de arquivos/fotos) ─────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Meet / Calendar ─────────────────────────────────────
# Conta de serviço GCP (JSON completo, uma linha)
GCP_SERVICE_ACCOUNT_JSON=
MEET_ADMIN_EMAIL=

# ── Cron Job ──────────────────────────────────────────────────
# Segredo para autenticar o endpoint /api/cron/digest
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# ── Debug (NÃO usar em produção) ──────────────────────────────
# DEBUG_API=1
# DEBUG_API_KEY=

# ── CI/Testes (somente ambiente de teste, NUNCA em produção) ──
# Ativa o endpoint /api/ci/admin-token (apenas quando NODE_ENV != 'production')
# CI_ADMIN_SECRET=

# ── Web3Forms (formulários públicos) ──────────────────────────
WEB3FORMS_API_KEY=

# ── Chat ──────────────────────────────────────────────────────
# Minutos de deduplicação de e-mails de chat (padrão: 5)
# CHAT_EMAIL_DEDUP_MIN=5
